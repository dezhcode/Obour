# ============================================================
#  تنظیم بدون تایپ در ترمینال
#
#  ۱. در File Manager سی پنل، کنار همین فایل یک فایل تازه به نام setup.env بساز
#     (یا از همین فایل یک کپی با نام setup.env بگیر) و مقادیر را جلوی = بنویس.
#  ۲. bash setup_all.sh را اجرا کن (یا از Cron Jobs؛ راهنما: DEPLOY_CPANEL_FA.md).
#  ۳. اسکریپت مقادیر را در .env ثبت می کند و setup.env را پاک می کند.
#
#  خالی گذاشتن یعنی «مقدار فعلی .env بماند». فاصله قبل و بعد از = نگذار.
#  این فایل نمونه است؛ مقدار واقعی را فقط در setup.env بنویس، نه اینجا.
# ============================================================

# توکن ربات عبور از @BotFather
BOT_TOKEN=

# توکن ربات Game Club از @BotFather (ربات جدا)
GAME_CLUB_BOT_TOKEN=

# آیدی عددی تلگرام ادمین ها از @userinfobot؛ چند تا با کاما
ADMIN_IDS=

# آدرس اپ روی هاست
WEBHOOK_BASE_URL=

# پنل PasarGuard (آدرس بدون /dashboard)
PANEL_BASE_URL=
PANEL_USERNAME=
PANEL_PASSWORD=

# فقط اگر هاست به api.telegram.org دسترسی ندارد، مثل socks5://host:port
TG_PROXY=

# کلید وب سرویس خدمات هوش مصنوعی aitoolifystudio (با sk_live_ شروع می شود)
AITOOLIFY_API_KEY=
