# ============================================================
#  Obour Bot  -  فایل نمونه تنظیمات
#  ساخت خودکار .env با توکن ها، آیدی ادمین و سکرت ها:  python setup_env.py
#  یا دستی کپی کن به .env و مقادیر را پر کن:   cp .env.example .env
#  بعد دسترسی را ببند:                 chmod 600 .env
# ============================================================

# ---------- تلگرام ----------
BOT_TOKEN=
ADMIN_IDS=

# ---------- وبهوک (روی هاست سی پنل حتما true) ----------
WEBHOOK_MODE=true
WEBHOOK_BASE_URL=https://dezhcode.pyho.ir/obour
# مسیر مخفی وبهوک. یک رشته تصادفی بگذار، حدس زدنی نباشد.
WEBHOOK_PATH=/tg/CHANGE_ME_RANDOM
# رشته تصادفی برای تایید هویت درخواست های تلگرام. الزامی.
# اگر خالی باشد ربات هیچ آپدیتی را نمی پذیرد (جلوگیری از آپدیت جعلی).
# ساخت:  python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# کلید مسیرهای مدیریتی: /status و /setwebhook و /delwebhook
# باید رشته ای متفاوت از WEBHOOK_SECRET باشد، چون در URL می آید و در
# access log هاست ذخیره می شود. می توانی به جای ?key= هدر X-Admin-Key
# بفرستی تا در لاگ ثبت نشود.
# ساخت:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_KEY=

# ---------- شبکه تلگرام ----------
# اگر سرور مستقیم به api.telegram.org دسترسی ندارد (هاست های ایران)
# یکی از این دو را پر کن. اگر دسترسی دارد، هر دو را خالی بگذار.
TG_PROXY=
TG_API_BASE=

# ---------- پنل PasarGuard ----------
PANEL_BASE_URL=https://zerofee.ok-exor.ir
PANEL_USERNAME=
PANEL_PASSWORD=
PANEL_API_KEY=
PANEL_GROUP_ID=all
PANEL_VERIFY_SSL=true

# ---------- دیتابیس و لاگ ----------
DB_PATH=data/obour.db
LOG_PATH=logs/obour.log
LOG_LEVEL=INFO

# ---------- تست رایگان ----------
TRIAL_ENABLED=true
TRIAL_MB=200
TRIAL_DAYS=1

# ---------- شارژ کیف پول ----------
# چند دقیقه مبلغ یکتای شارژ برای کاربر نگه داشته شود (مهلت پرداخت و
# تایمر مینی اپ). رسید دیرتر هم پذیرفته می شود.
CHARGE_TTL_MINUTES=2

# ---------- پرداخت کریپتو (TON و USDT روی شبکه TON) ----------
# برای کاربرهای خارج از کشور. خالی بودن آدرس یعنی این بخش خاموش است.
# فقط آدرس لازم است؛ کلید خصوصی یا ۲۴ کلمه را هیچ وقت اینجا نگذار.
# نرخ تتر و TON از پنل ادمین: تنظیمات ← «نرخ تتر» / «نرخ TON».
# راهنمای کامل: CRYPTO_FA.md
TON_NETWORK=mainnet            # برای تست: testnet
TON_RECEIVE_ADDRESS=
# کلید API از @tonapibot (برای testnet کلید جدا می دهد)
TONCENTER_API_KEY=
# روی mainnet خالی بماند (تتر رسمی). روی testnet آدرس جتون تستی خودت
TON_USDT_MASTER=
TON_USDT_DECIMALS=6
CRYPTO_INVOICE_MINUTES=20
# اگر هاست به toncenter.com دسترسی ندارد: http://host:port یا socks5://...
TON_PROXY=

# ---------- قیمت گذاری ----------
CUSTOM_RATE_PER_GB=3500

# ---------- افکت پیام (Bot API 7.2) ----------
# فقط در چت خصوصی و فقط روی پیام های تازه کار می کند (نه ویرایش پیام).
# برای گرفتن آیدی یک افکت، همان پیام را با افکت دلخواه برای ربات بفرست
# و مقدار effect_id را از آپدیت بردار. خالی گذاشتن = بدون افکت.
EFFECT_TRIAL=5420104476780411731
EFFECT_CHARGE=5343933807311467091
EFFECT_PURCHASE=5276520408655338097

# ---------- QR روی قاب برند ----------
# مقادیر زیر برای assets/qr_frame.png اندازه گیری شده اند.
# اگر قاب را عوض کردی، مختصات باکس سفید تصویر جدید را جایگزین کن.
QR_FRAME_PATH=assets/qr_frame.png
QR_BOX_X=213
QR_BOX_Y=376
QR_BOX_SIZE=660
QR_FG=#0a1e3f
QR_BG=#ffffff

# ---------- سیاست تمدید ----------
# true  : روزهای باقی مانده سرویس سوخت نمی شود و به مدت جدید اضافه می شود
#         (فقط روزهای کامل، تا عدد پنل و دیتابیس یکی بماند)
# false : تمدید از لحظه پرداخت حساب می شود
RENEW_KEEP_REMAINING=true

# ---------- پاداش هم سفرها (معرفی) ----------
# پاداش فقط وقتی داده می شود که کاربر دعوت شده واقعا خرید کند.
REF_ENABLED=true
# درصد از هر خرید کاربر دعوت شده که به کیف پول معرف می رود
REF_PERCENT=10
# پاداش ثابت اضافه برای اولین خرید هر دعوت شده (تومان). ۰ = بدون پاداش ثابت
REF_FIRST_BONUS=0
# حداقل مبلغ خرید برای تعلق پاداش (تومان)
REF_MIN_ORDER=0
# سقف هر پاداش (تومان). ۰ = بی سقف
REF_MAX_REWARD=0

# ---------- عضویت اجباری برای تست رایگان ----------
# با کاما جدا کن. کانال عمومی: @Obour_Net
# کانال خصوصی: -1001234567890=https://t.me/+AbCdEf
# ربات باید در کانال ادمین باشد، وگرنه بررسی عضویت ممکن نیست و
# عمدا کاربر رد می شود تا تنظیمات غلط جلوی تست را نگیرد.
JOIN_CHANNELS=@Obour_Net
JOIN_FOR_TRIAL=true

# مهلت پاسخ پنل به ثانیه. اگر پنلت کند است این را بالاتر ببر، ولی
# بدان که کاربر همین مدت پشت صفحه در حال بارگذاری می ماند.
PANEL_TIMEOUT=8

# ---------- کران خودکار ----------
# ربات خودش کارهای دوره ای (هشدار حجم و انقضا، یادآوری فیش، ادامه
# ارسال همگانی) را انجام می دهد و به کران هاست نیازی نیست.
AUTOCRON=true
# هر چند دقیقه یک دور اجرا شود (حداقل ۵)
AUTOCRON_MINUTES=15
# سقف زمانی هر دور به ثانیه
AUTOCRON_BUDGET=15

# ---------- خودپینگ ----------
# ربات هر چند دقیقه یک درخواست به /health خودش می زند تا هاست پروسه را
# نخواباند و کارهای دوره ای هم اجرا شوند. به WEBHOOK_BASE_URL نیاز دارد.
KEEPALIVE=true
KEEPALIVE_MINUTES=15

# ---------- خدمات هوش مصنوعی (canboso.com) ----------
# کلید خریدار (tgb_...) که ربات canboso می دهد. با آن موجودی تو خرج می شود؛
# فقط همین جا بگذارش. نرخ ارز و سود از پنل ادمین: تنظیمات ← خدمات هوش مصنوعی
CANBOSO_API_KEY=

# ---------- خدمات هوش مصنوعی (aitoolifystudio Reseller API) ----------
# کلید فروش عمده (sk_live_...). اگر پر باشد به جای canboso استفاده می شود.
# با آن موجودی تو خرج می شود؛ فقط همین جا بگذارش و هیچ جا کامیت نکن.
AITOOLIFY_API_KEY=

# ---------- دستیار هوش مصنوعی (وب سرویس dezhcode) ----------
# کلید وب سرویس هوش مصنوعی. فقط همین جا (در .env) بگذارش و هیچ جا کامیت نکن.
# بدون کلید، دستیار پشتیبانی، پیشنهاد پلن، بررسی رسید و گزارش روزانه خاموش اند.
AI_API_KEY=
# آدرس وب سرویس (پیش فرض https://dezhcode.pyho.ir)
AI_BASE_URL=
# حداکثر انتظار برای جواب در ربات به ثانیه (بیشتر از ۴۰ نگذار)
AI_TIMEOUT=38

# ---------- Game Club (ربات جدای بازی) ----------
# ربات دوم برای منچ (و بعدا حکم و اسم فامیل). روی همین هاست و همین پروسه اجرا
# می شود ولی ربات و دیتابیس خودش را دارد. راه اندازی: game_club/README_FA.md
# با پر شدن یوزرنیم، کارت «بازی کن و امتیاز بگیر» در صفحه اصلی مینی اپ عبور می آید.
GAME_CLUB_BOT_TOKEN=
GAME_CLUB_BOT_USERNAME=
# رشته تصادفی جدا از WEBHOOK_SECRET؛ بدونش وبهوک Game Club بسته می ماند
# ساخت:  python -c "import secrets;print(secrets.token_urlsafe(32))"
GAME_CLUB_WEBHOOK_SECRET=
# دیتابیس جدای Game Club (کنار دیتابیس عبور، ولی فایل جدا)
GAME_CLUB_DB_PATH=data/game_club.db
# زیرمسیر مینی اپ و API روی همان دامنه عبور (پیش فرض gc → https://site/obour/gc/)
GAME_CLUB_PATH=gc
# هر امتیاز چند تومان از کیف پول عبور
GAME_CLUB_POINT_TOMAN=100
# false = بازی با امتیاز خاموش؛ فقط بازی آزاد
GAME_CLUB_STAKE=true
# ورودی های مجاز بازی امتیازی و بسته های شارژ (امتیاز، با کاما)
GAME_CLUB_ENTRIES=50,100,250,500
GAME_CLUB_PACKS=250,500,1000,2500
# سهم عبور از جایزه به درصد (۰ = برنده همه را می برد)
GAME_CLUB_RAKE=0
# ثانیه های هر نوبت؛ بعدش تاس و حرکت خودکار
GAME_CLUB_TURN_SECONDS=20
# بازی آزاد با ناشناس: اگر بعد از این چند ثانیه حریف نیامد، ربات می نشیند
GAME_CLUB_BOT_FILL_SECONDS=15
