# نمونه تنظیمات Passenger برای کم کردن تاخیر راه اندازی دوباره.
#
# مشکل: Passenger پروسه بیکار را بعد از مدتی می کشد تا رم آزاد شود.
# کاربر بعدی باید منتظر بماند تا پایتون دوباره بالا بیاید - همان
# تاخیری که بعد از چند ساعت بی کاری ربات حس می شود.
#
# این فایل را کنار passenger_wsgi.py با نام .htaccess بگذار.
# توجه: بعضی هاست ها این دستورها را نادیده می گیرند (اجازه نمی دهند).
# اگر کار نکرد، راه مطمئن تر همان پینگ دوره ای /health است.

# حداقل یک نمونه همیشه زنده بماند
PassengerMinInstances 1

# پروسه بیکار را تا این مدت (ثانیه) نکش. ۰ یعنی هیچ وقت.
PassengerPoolIdleTime 0
